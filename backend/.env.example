# Leave all keys empty to run in demo mode (simulated assistant answers). Each key turns on that assistant.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# auto = demo only when no keys are set. true = always demo. false = always live.
DEMO_MODE=auto
# Optional overrides
CLAUDE_ASSISTANT_MODEL=claude-sonnet-5-5
CLAUDE_UTILITY_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_TOOL=web_search
GEMINI_MODEL=gemini-3.7-flash
PERPLEXITY_MODEL=sonar
MAX_JOURNEYS=12
